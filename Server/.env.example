DATABASE_URL=postgres://symbols_owner:replace_with_local_password@127.0.0.1:5432/symbols
HOST=127.0.0.1
PORT=3000
PG_POOL_MAX=10
LOG_LEVEL=info
# For production Compose set all passwords to different random URL-safe values.
POSTGRES_PASSWORD=
OWNER_PASSWORD=
APP_PASSWORD=
METRICS_TOKEN=
DOMAIN=
ACME_EMAIL=
# Empty by default. Compose sets the exact Caddy address on its private network.
TRUST_PROXY=
# Local imported avatars, optional. Compose uses its mounted public/avatars directory.
AVATAR_ROOT=private/avatars
